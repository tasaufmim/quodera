# ─────────────────────────────────────────────────────────────────────────────
# Quodera — secret manifest (docs/ops/PROVISIONING.md has the full runbook)
#
# Copy to .env for local dev. NEVER commit real values — .env* is gitignored
# and gitleaks runs in CI and on every pre-commit.
#
# Scopes:
#   server   = server-only (never prefixed NEXT_PUBLIC_; leaking = breach)
#   public   = inlined into the client bundle (fine to expose)
#   ci       = GitHub Actions secret/variable, set in repo settings
#   preview  = Vercel Preview environment
#   prod     = Vercel Production environment
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase 1 · in use ─────────────────────────────────────────────────────────

# RUNTIME connection — the unprivileged quodera_app role (created by
# migrations). Must NOT be a superuser: superusers bypass RLS entirely
# (ADR 0008). Local Docker Postgres (pnpm db:up); in prod: Neon POOLED string
# with the app role.
# server / preview / prod
DATABASE_URL=postgres://quodera_app:quodera_app_dev@localhost:5433/quodera

# ADMIN connection — superuser / table owner, used ONLY by migrations and test
# fixtures. Locally the Docker `postgres` user; in prod the Neon project owner.
# server (scripts only)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/quodera

# SYSTEM connection — role quodera_system (ADR 0010): the sanctioned
# cross-tenant operator (upgrade carry-over). Policies grant it explicitly;
# the runtime role cannot impersonate it.
# server / prod
DATABASE_SYSTEM_URL=postgres://quodera_system:quodera_system_dev@localhost:5433/quodera

# Password assigned to quodera_app when migrations bootstrap it. Committed
# default is a throwaway for local Docker; production sets a real secret in
# the migration environment only.
# server (scripts only)
APP_DB_PASSWORD=quodera_app_dev

# Password assigned to quodera_system (ADR 0010) — same rules as APP_DB_PASSWORD.
# server (scripts only)
APP_SYSTEM_DB_PASSWORD=quodera_system_dev

# Log verbosity: fatal | error | warn | info | debug | trace
# public
LOG_LEVEL=info

# Sentry error tracking. Empty = SDK no-ops (see src/instrumentation.ts).
# server / preview / prod
SENTRY_DSN=

# Client-side Sentry (must be NEXT_PUBLIC_ to be inlined into the bundle).
# public / preview / prod
NEXT_PUBLIC_SENTRY_DSN=

# ── Phase 2.1 · auth — in use ────────────────────────────────────────────────

# Sign/verify key for better-auth sessions. Generate: openssl rand -base64 32
# server / preview / prod — REQUIRED in production (auth fails fast without it)
BETTER_AUTH_SECRET=

# Canonical origin. Defaults to http://localhost:3000 when unset.
# public / preview / prod
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers — both keys must be set for a provider to activate;
# unset providers simply don't register their routes.
# Google OAuth 2.0 app (redirect URI: <origin>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app (callback: <origin>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Phase 2.2 · rate limiting — in use ───────────────────────────────────────

# Upstash Redis (free tier) — global quotas across serverless instances.
# Without these, quotas fall back to per-instance memory: fine locally, LOUD
# error in production. Create a database at https://upstash.com, copy both
# values from the REST API section.
# server / preview / prod
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Phase 2.3 · guest mode — in use ──────────────────────────────────────────

# Guards /api/cron/purge-guests (Vercel cron sends it as a Bearer token).
# Without it the purge endpoint fails CLOSED (401 for everything) — a missing
# secret must never mean an open purge route. Set in Vercel Production env.
# server / prod
CRON_SECRET=

# ── Phase 2 · reserved, not yet read ────────────────────────────────────────

# SMTP via Resend (magic links / verification). Sender on a subdomain you own.
# Until set, the magic-link sender LOGS the link in dev and errors in prod.
RESEND_API_KEY=
EMAIL_FROM="Quodera <no-reply@quodera.dev>"

# ── Phase 2.5 · document storage — in use ───────────────────────────────────

# Cloudflare R2 (10 GB free): raw document bytes. WITHOUT these, uploads fall
# back to the dev object store (Postgres bytea) — functional everywhere,
# NOT intended for production, and it logs one loud error in prod.
# Create a bucket, then "Manage API Tokens" → S3 API credentials.
# server / prod
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quodera-documents

# ── Phase 3+ · RAG — GEMINI in use (3.3), chat reserved ─────────────────────

# Google AI Studio (embeddings — ADR 0004 postscript): gemini-embedding-001
# @ 768 dims, batched. Without it, uploads parse but fail honestly with
# `embedding-unavailable` (stated in the UI). Create free at
# aistudio.google.com → Get API key.
# server / preview / prod
GEMINI_API_KEY=

# ── Phase 4 · chat — in use ──────────────────────────────────────────────────

# OpenRouter — SERVER PROXY ONLY (GUARDRAILS #5): the demo pool. Without it,
# chat answers honestly with 503 chat-unavailable (retrieval still works).
# Free tier: 20 RPM / 50 RPD shared — the 5/day per-user quota keeps us inside.
# server / preview / prod
OPENROUTER_API_KEY=

# Demo-pool model. Default: "openrouter/free" — OpenRouter's free-models
# router, which self-heals as the free roster turns over weekly. Pin a
# specific :free model here if you want determinism at the cost of rot risk.
# server / preview / prod
OPENROUTER_DEMO_MODEL=openrouter/free

# Default model for BYO-key users (they can also pass per-request `model`).
# server / preview / prod
OPENROUTER_BYO_MODEL=deepseek/deepseek-chat-v3.1
